    {
      "identity": "biyoshi-53-q3",
      "questionId": "biyoshi-2026-first-gakka-q3",
      "status": "LOCAL_LEGAL_FLAGS_RESOLVED",
      "publication": false,
      "sourceResultSha256": "532651c7b754c11dd4f0049aa64ee904838d12cf223260a15c85d64de7b4b7eb",
      "receiptSha256": "e601c0d6e2effe71a16dcb089ce0f90a177923aba982e68bb745ccb98e5db9af",
      "beforeObjectSha256": "f44c3d0e7a488a26dfb34975bf04621fefbfc2a5baa383eafb6e2a7afa20b113",
      "afterObjectSha256": "b0f1a6f8bd9223897ba1b41cf5d7bee72d19996d6e27d50e302f35a75f37a79c",
      "edits": [
        {
          "field": "explanation",
          "before": "管理美容師は、美容師が常時2人以上従事する美容所で、衛生管理を担当させるために置くものです。経営管理のためではありません。",
          "after": "美容師法第12条の3第1項により、美容師である従業者の数が常時2人以上である美容所の開設者は、美容所を衛生的に管理させるため、管理美容師を置かなければなりません。経営管理のためではありません。",
          "singleBefore": true,
          "beforeFieldSha256": "36fd72260434c6cc48a0d22a5d8203050011ee8b007b22a1307f5d4f720500ac",
          "afterFieldSha256": "bd34804a49b062e77360fff671487c1309a67593a0fbd3e8bc6ba3e220ea82e1"
        },
        {
          "field": "explanation",
          "before": "置くべき美容所に置かなかった場合は、行政処分として美容所の閉鎖命令を受けることがあります。",
          "after": "置くべき美容所に置かなかった場合は、美容師法第15条第1項(第12条の3違反)により、都道府県知事から期間を定めて美容所の閉鎖を命じられることがあります。",
          "singleBefore": true,
          "beforeFieldSha256": "bd34804a49b062e77360fff671487c1309a67593a0fbd3e8bc6ba3e220ea82e1",
          "afterFieldSha256": "7fba2abedb26f79592ced87ea7c2d6b43676b1696e78297afc08cfac899b9731"
        },
        {
          "field": "choiceExplanations.2",
          "before": "管理美容師の資格認定講習会の修了は、美容師名簿の登録事項には含まれていないと考えられます。ただし、この点は提供資料外の知識です。",
          "after": "美容師法施行規則第2条が掲げる名簿の登録事項(登録番号、本籍地都道府県名、氏名、試験合格の年月、処分、再免許、書換え交付・再交付、登録消除など)に、管理美容師の講習会修了年月日は含まれていません。",
          "singleBefore": true,
          "beforeFieldSha256": "018b3a4f2575da2aace63eecfd151b0c5411a0932099d4a1b8f3302ab3116f97",
          "afterFieldSha256": "1d26a30e4a40830bd1503fc06e61eec0046abc048d37738da6ac801ddf1734db"
        },
        {
          "field": "choiceExplanations.3",
          "before": "管理美容師の設置が必要となるのは、美容師が「常時」2人以上従事する美容所です。",
          "after": "美容師法第12条の3第1項により、管理美容師の設置が必要となるのは、美容師である従業者の数が「常時」2人以上である美容所です。",
          "singleBefore": true,
          "beforeFieldSha256": "261e6c9e701c34938ee8c0e924513ffcd1b519e2dade7c260c051f1702cd21cb",
          "afterFieldSha256": "2e4bd4985c5db25f60a41ec2fe275d7e074b9dba126653b711aeca17a9c8227d"
        },
        {
          "field": "choiceExplanations.4",
          "before": "管理美容師を置かなければならない美容所に置かなかった場合は、行政処分として美容所の閉鎖命令を受けることがあります。",
          "after": "管理美容師を置かなければならない美容所に置かなかった場合は、美容師法第15条第1項により、都道府県知事から期間を定めて美容所の閉鎖を命じられることがあります。",
          "singleBefore": true,
          "beforeFieldSha256": "17c7a93978791f04404956fa3fdc4a2e49ae2047440828b7550c71dcef78ee27",
          "afterFieldSha256": "d83377a6ce928bf3f6be11390702e446c85bb5ae7e49d786da7bf4fcb2ba3e8f"
        }
      ],
