        "subject": "労働基準法及び労働安全衛生法",
        "officialAnswerNumber": "D",
        "type": "multiple-choice",
        "category": "労働基準法及び労働安全衛生法",
        "topicTags": [
          "労働基準法及び労働安全衛生法",
