{
  "name": "過去問AI",
  "short_name": "過去問AI",
  "description": "AIネイティブな情報処理技術者試験 過去問学習。オフラインでも演習可能。",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#fafafa",
  "theme_color": "#0284c7",
  "lang": "ja",
  "dir": "ltr",
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "ランダム演習",
      "short_name": "演習",
      "description": "全試験からランダム出題",
      "url": "/quiz?mode=random",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "復習モード",
      "short_name": "復習",
      "description": "間違えた問題を復習",
      "url": "/quiz?mode=review",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "オフライン演習",
      "short_name": "オフライン",
      "description": "ブックマーク済み問題で演習",
      "url": "/offline",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
}
