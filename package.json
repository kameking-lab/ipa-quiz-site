{
  "name": "ipa-quiz-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "fetch:pdfs": "tsx scripts/fetch-ipa-pdfs.ts",
    "parse:pdfs": "tsx --env-file=.env.local scripts/parse-pdf-to-json.ts",
    "validate:questions": "tsx scripts/validate-questions.ts",
    "tag:topics": "tsx scripts/topic-tagger.ts",
    "fetch:pdfs:all": "tsx scripts/fetch-ipa-pdfs.ts --all",
    "parse:pdfs:all": "tsx --env-file=.env.local scripts/parse-pdf-to-json.ts --all",
    "parse:dry-run": "tsx --env-file=.env.local scripts/parse-all.ts --dry-run",
    "parse:all": "tsx --env-file=.env.local scripts/parse-all.ts",
    "parse:all:a": "tsx --env-file=.env.local scripts/parse-all.ts --section=A",
    "parse:all:b": "tsx --env-file=.env.local scripts/parse-all.ts --section=B",
    "parse:all:c": "tsx --env-file=.env.local scripts/parse-all.ts --section=C",
    "parse:afternoon": "tsx --env-file=.env.local scripts/parse-afternoon/parse-ap-afternoon.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "nodemailer": "^8.0.5",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.0.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
