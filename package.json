{
  "name": "ipa-quiz-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "fetch:pdfs": "tsx scripts/fetch-ipa-pdfs.ts",
    "parse:pdfs": "tsx --env-file=.env.local scripts/parse-pdf-to-json.ts",
    "validate:questions": "tsx scripts/validate-questions.ts",
    "tag:topics": "tsx scripts/topic-tagger.ts",
    "fetch:pdfs:all": "tsx scripts/fetch-ipa-pdfs.ts --all",
    "parse:pdfs:all": "tsx --env-file=.env.local scripts/parse-pdf-to-json.ts --all",
    "parse:dry-run": "tsx --env-file=.env.local scripts/parse-all.ts --dry-run",
    "parse:all": "tsx --env-file=.env.local scripts/parse-all.ts",
    "parse:all:a": "tsx --env-file=.env.local scripts/parse-all.ts --section=A",
    "parse:all:b": "tsx --env-file=.env.local scripts/parse-all.ts --section=B",
    "parse:all:c": "tsx --env-file=.env.local scripts/parse-all.ts --section=C"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
