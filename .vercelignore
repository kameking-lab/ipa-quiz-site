# Files excluded from the Vercel deployment build context. None of these are
# imported by app/lib/components/data or read at runtime (verified phase 12),
# and `next build`'s type-check uses glob includes, so absent files are simply
# skipped — excluding the .ts/.tsx test+script files also trims what Vercel's
# type-check has to process. CI (GitHub Actions) keeps the full checkout, so
# tests/lint/e2e run there unchanged.
#
# NOTE: logs/ is intentionally NOT excluded — app/final-review-v3 and
# app/strategy-discussion-v2 read logs/*.md at build time (verified: removing
# logs/ breaks the build).

# Tests (run in CI, never on the Vercel build)
__tests__/
tests/

# Keep the production migration entry point in the uploaded build context.
scripts/*
!scripts/vercel-migrate.mjs
# Builds the copilot BM25 index before next build (see package.json "build").
!scripts/build-copilot-index.ts

# Internal docs (markdown; not imported by the app)
docs/

# Retained source images for unpublished k11 question data, never served.
private-assets/

# Local / editor / capture artifacts
.vscode/
.idea/
screenshots/
.playwright-mcp/
playwright-report/
