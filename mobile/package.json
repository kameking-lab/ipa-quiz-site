{
  "name": "kakomon-ai-ios",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/asc_image_check.test.mjs scripts/asc_repository_check.test.mjs scripts/launch-screen.test.mjs scripts/next-build-number.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "catalog": "tsx --tsconfig tsconfig.scripts.json scripts/generate-catalog.ts",
    "build": "npm run catalog && npm run typecheck && vite build && node scripts/measure-bundle.mjs",
    "ios:prepare": "node scripts/prepare-ios.mjs",
    "ios:test": "node --test scripts/ios-project.test.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@revenuecat/purchases-capacitor": "13.8.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "0.35.5",
    "tsx": "4.22.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
