# Codemagic environment group: kakomon_ios
# All values below are public configuration, never server secrets.
# Missing required values leave ads disabled and the app builds normally.
MOBILE_ADS_ENABLED=false
MOBILE_ADS_WEB_CONSENT_READY=false
MOBILE_ADSENSE_CLIENT=
MOBILE_ADSENSE_SLOT=
# Exact publisher-bound script URL from Google's Privacy & messaging UI:
# https://fundingchoicesmessages.google.com/i/pub-<16 digits>?ers=1
MOBILE_ADS_CMP_SCRIPT_URL=
# Optional: unnecessary for WebView-only ads; no sample/fallback ID is shipped.
MOBILE_GAD_APPLICATION_ID=
