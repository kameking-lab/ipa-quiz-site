# Server-only. Never set NEXT_PUBLIC_ or MOBILE_ equivalents.
# Correct code automatically creates the reserved free, unsubscribed member.
# No manual account, Google account, email inbox, USER_ID or EMAIL setting.
APP_REVIEW_LOGIN_ENABLED=
# SHA-256 hex digest of an independently generated >=32-byte random base64url code.
# Raw code goes only in the owner's secret store and App Review credentials.
APP_REVIEW_CODE_SHA256=
# Absolute ISO-8601 expiration with timezone; allow enough time for review.
APP_REVIEW_EXPIRES_AT=
# Existing server infrastructure (no new service or schema required):
AUTH_URL=
AUTH_SECRET=
DATABASE_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
