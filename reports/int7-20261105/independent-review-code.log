[{'id': 'junkango-kansai-2026-q139', 'exam': 'junkango-kansai', 'year': 2026, 'season': 'annual', 'session': 'gakka', 'qNumber': 139, 'type': 'multiple-choice', 'category': '精神看護', 'topicTags': ['精神看護'], 'difficulty': 3, 'question': '退院後生活環境相談員の選任が義務付けられている入院形態はどれか。', 'answer': ['イ', 'エ'], 'explanation': '公式正答2・4。2または4の単独選択を正解とする。両方の選択を要求しない。\n1：任意入院は本人の同意による入院であり、この設問が問う相談員選任義務の対象ではない。\n2：医療保護入院者には退院後生活環境相談員の選任が義務付けられる。公式も2を正解としている。\n3：応急入院は緊急時の短期間の入院形態であり、本問の選任義務の正答には含まれない。\n4：2024年4月施行の改正で措置入院者にも選任が義務化された。公式は4も単独正解と認める。', 'sourcePdfUrl': 'https://www.kouiki-kansai.jp/material/files/group/12/mondai_jyunkangoshi2026.pdf', 'sourceAnswerUrl': 'https://www.kouiki-kansai.jp/material/files/group/3/kaitou_jyunkangoshi2026.pdf', 'sourceAttribution': '出典：関西広域連合 令和7年度准看護師試験 問139（問題・公式解答）。本文の改行・空白・ルビ表示を整形。原本画像はルビ・図表を含め保持。解説は過去問AI独自作成。', 'license': 'INT7-owner-decision', 'publicAllowed': True, 'needsReview': False, 'lastUpdated': '2026-11-04', 'hasImage': True, 'fiscalYear': 2025, 'examDate': '2026-02-01', 'officialAnswerNumber': '2・4', 'choices': {'ア': '任意入院', 'イ': '医療保護入院', 'ウ': '応急入院', 'エ': '措置入院'}, 'choiceExplanations': {'ア': '任意入院は本人の同意による入院であり、この設問が問う相談員選任義務の対象ではない。', 'イ': '医療保護入院者には退院後生活環境相談員の選任が義務付けられる。公式も2を正解としている。', 'ウ': '応急入院は緊急時の短期間の入院形態であり、本問の選任義務の正答には含まれない。', 'エ': '2024年4月施行の改正で措置入院者にも選任が義務化された。公式は4も単独正解と認める。'}, 'explanationCoverage': 'full', 'imageUrls': ['/images/questions/batch3/b193d959d2e5f7efaf629042f800538fc170581651120755cd02d139c79d24a8.webp'], 'imageAltTexts': ['2026年 139 原問題・図表（1/1）']}]
import type { ChoiceKey, Question } from "./types";

export const CHOICE_KEYS: ChoiceKey[] = ["ア", "イ", "ウ", "エ", "オ", "カ", "キ", "ク", "ケ", "コ", "サ", "シ", "ス", "セ", "ソ", "タ"];
export const CHOICE_SHORTCUTS = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"];

export function getChoiceKeys(choices: Question["choices"]): ChoiceKey[] {
  return CHOICE_KEYS.filter(key => choices?.[key] !== undefined);
}

/** An array lists independently accepted choices, not a required multi-selection. */
export function isAcceptedAnswer(answer: Question["answer"], selected: string | undefined): boolean {
  return selected !== undefined && (Array.isArray(answer) ? answer.some(key => key === selected) : answer === selected);
}

export function formatAcceptedAnswers(answer: Question["answer"]): string {
  return Array.isArray(answer) ? answer.join("・") : answer;
}

/** 1問で選ぶ肢の数。「二つとも答えなさい」形式は2、それ以外は1。 */
export function requiredSelectionCount(question: Pick<Question, "requiredSelections">): number {
  const count = question.requiredSelections ?? 1;
  return Number.isInteger(count) && count > 1 ? count : 1;
}

/** 許容された正答肢から指定数を選ぶ。指定数の省略時は従来の全肢一致を保つ。 */
export function isCompleteSelectionCorrect(answer: Question["answer"], selected: readonly string[], requiredSelections?: number, acceptedCombinations?: readonly (readonly string[])[]): boolean {
  if (acceptedCombinations) return new Set(selected).size === selected.length && acceptedCombinations.some(set => set.length > 0 && new Set(set).size === set.length && set.length === selected.length && set.every(key => selected.includes(key)));
  const keys: readonly string[] = Array.isArray(answer) ? answer : [answer];
  const count = requiredSelections ?? keys.length;
  return Number.isInteger(count) && count > 0 && count <= keys.length &&
    new Set(keys).size === keys.length && selected.length === count &&
    new Set(selected).size === count && selected.every(key => keys.includes(key));
}

export function selectionInstruction(answer: Question["answer"], count: number): string {
  const accepted = Array.isArray(answer) ? answer.length : 1;
  return accepted > count
    ? "正答として認められる" + accepted + "肢のうち、" + count + "肢選ぶと採点します"
    : "正解は" + count + "つあります。" + count + "つ選ぶと採点します";
}

/** 解答記録用に、選んだ肢を肢の並び順で連結する（例: "イ・エ"）。 */
export function formatSelection(selected: readonly string[]): string {
  return CHOICE_KEYS.filter(key => selected.includes(key)).join("・");
}

/** Enabling the iOS service enables ONE content policy for web, SSR and APIs.
 * Client headers never disable this policy. Dormant web deployments keep their
 * established public SEO behavior until the mobile service is activated. */
export function strictContentGateEnabled(env: Readonly<Record<string,string|undefined>> = process.env) {
  return env.MOBILE_IAP_ENABLED === "true";
}

