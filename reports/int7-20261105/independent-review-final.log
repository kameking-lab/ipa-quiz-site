+    const edition = verifiedPaper
+      ? VERIFIED_MEDICAL_EDITIONS[verifiedPaper[1] ?? ""]?.[verifiedPaper[2]?.slice(0, 2) ?? ""]
+      : undefined;
+    if (edition) return edition;
