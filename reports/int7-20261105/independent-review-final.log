import { isReferenceOnlyQuestionId } from "./assessment";
import { nativeBQuestionIssue } from "./native-b";
import { numericQuestionIssue } from "./numeric";
import { orderingQuestionIssue } from "./ordering";
import { hasUnrenderableContent } from "./content-quality";
import type { Question, QuizFilter } from "./types";
import type { HistoryStore } from "@/lib/storage/history";
import { usesNumberedChoices } from "./display";



export function isPlaceholderExplanation(q: Question): boolean {
  const explanation = q.explanation.trim();
  return /^������[�A�C�E�G]�ł�[�B.]?$/.test(explanation) || explanation === "";
}

/**
 * A question can be advertised in an IPA paper list only when the interactive
 * player can render and explain it. Keeping this predicate shared prevents a
 * paper page from promising more questions than the quiz can actually serve.
 */
export function isPracticeReadyQuestion(q: Question): boolean {
  return !q.officialScoring && q.publicAllowed !== false && !isReferenceOnlyQuestionId(q.id) && !nativeBQuestionIssue(q) && !numericQuestionIssue(q) && !orderingQuestionIssue(q) && !hasUnrenderableContent(q) && !q.needsReview && !isPlaceholderExplanation(q);
}

export function filterQuestions(
  all: Question[],
  filter: QuizFilter,
  history?: HistoryStore,
): Question[] {
  let pool = [...all];

  if (filter.examGroup && filter.examGroup.length > 0) {
    const set = new Set(filter.examGroup);
    pool = pool.filter((q) => set.has(q.exam));
  } else if (filter.exam) {
    pool = pool.filter((q) => q.exam === filter.exam);
  }
  if (filter.year) pool = pool.filter((q) => q.year === filter.year);
  if (filter.season) pool = pool.filter((q) => q.season === filter.season);
  if (filter.session) pool = pool.filter((q) => q.session === filter.session);
  if (filter.topicTag) {
    pool = pool.filter((q) => q.topicTags.includes(filter.topicTag!));
  }
  if (filter.categoryGroup && filter.categoryGroup.length > 0) {
    const set = new Set(filter.categoryGroup);
    pool = pool.filter((q) => set.has(q.category));
  } else if (filter.category) {
    pool = pool.filter((q) => q.category === filter.category);
  }
  if (filter.calculationOnly) {
    pool = pool.filter((q) => q.isCalculation === true);
  }
  if (filter.mode === "review" && history) {
    const wrongIds = new Set(history.getWrongIds());
    const starredIds = new Set(history.getStarredIds());
    pool = pool.filter((q) => wrongIds.has(q.id) || starredIds.has(q.id));
  }
  if (filter.mode === "unanswered" && history) {
    const answered = new Set(history.getAnsweredIds());
    pool = pool.filter((q) => !answered.has(q.id));
  }
  if (filter.excludeRecent && history) {
    const recent = new Set(history.getRecentIds(2));
    pool = pool.filter((q) => !recent.has(q.id));
  }

  pool = pool.filter(isPracticeReadyQuestion);

  if (filter.mode === "random") {
    shuffle(pool);
  } else if (filter.inOrder) {
    pool.sort((a, b) => a.qNumber - b.qNumber || (a.part ?? "").localeCompare(b.part ?? ""));
  }

  return pool;
}

export function shuffle<T>(arr: T[]): T[] {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

export function shuffleChoices(q: Question): Question {
  // Printed numbers and official answer fields refer to the original order.
  if (usesNumberedChoices(q.exam) || q.officialAnswerNumber !== undefined) return q;
  if (["chintai", "kyusui", "biru-kan", "gijutsushi1-kikai", "hoshasen-1", "hoshasen-2", "khk-kikai-kou", "khk-kikai-otsu", "energy-kanri", "reform-mgr", "shohi-sodan"].includes(q.exam)) return q;
  if (["denki1","kisho","kenchiku-setsubishi","chizai2","kanteishi","kaikeishi","judo-seifukushi","riku-toku-kokunai","kai-toku2","kai-toku3","koku-toku","land-special1","riku-tech1","maritime4","aviation-comm","amateur1","maritime-special1","riku-tech2","amateur2","maritime-radar","maritime3","maritime2","maritime1","general3","general2","general1","land-special2","land-special3","biyoshi","tsushin2","shuwa","shinrishi"].includes(q.exam) || q.exam.startsWith("kikenbutsu-otsu")) return q;
  if (!q.choices) return q;
  // Labels in authored prose refer to the original choices. Reordering only the
  // answer map would silently contradict the explanation (for example AP 2017�H ��2).
  const prose = [q.question, q.explanation, ...Object.values(q.choices), ...Object.values(q.choiceExplanations ?? {})].join("\n");
  if (/(?:^|[^�@-���[])[�A�C�E�G�I�J�L�N�P�R](?![�@-���[])/u.test(prose) || Array.isArray(q.answer) || Object.keys(q.choices).length !== 4) return q;
  const keys: Array<"�A" | "�C" | "�E" | "�G"> = ["�A", "�C", "�E", "�G"];
  const originalKeys = [...keys];
  shuffle(originalKeys);
  const values = originalKeys.map((k) => q.choices![k]!);
  const newChoices: Record<"�A" | "�C" | "�E" | "�G", string> = {
    �A: values[0],
    �C: values[1],
    �E: values[2],
    �G: values[3],
  };
  const originalAnswerKey = Array.isArray(q.answer) ? q.answer[0] : q.answer;
  const newAnswerKey = keys[originalKeys.indexOf(originalAnswerKey as "�A" | "�C" | "�E" | "�G")];
  const choiceExplanations = q.choiceExplanations
    ? Object.fromEntries(keys.map((key, index) => [key, q.choiceExplanations![originalKeys[index]]]))
    : undefined;
  const choiceImageUrls = q.choiceImageUrls
    ? Object.fromEntries(keys.map((key, index) => [key, q.choiceImageUrls![originalKeys[index]]]))
    : undefined;
  return { ...q, choices: newChoices, answer: newAnswerKey, choiceExplanations, choiceImageUrls };
}
"""Build INT7 public projections; preserve reviewed private manuscripts byte for byte."""
import hashlib
import json
import re
import shutil
from collections import Counter
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
STAGING = ROOT / 'data/qualification-staging'
OUTPUT = ROOT / 'data/questions/batch3'
REPORT = ROOT / 'reports/int7-20261105'
KEYS = list('�A�C�E�G�I�J�L�N�P�R�T�V�X�Z�\�^')
ASSETS = {}
EXCLUDED = []


def read(path):
    return json.loads(path.read_text(encoding='utf-8-sig'))


def asset(code, value):
    path = ROOT / value if value.startswith('data/') else STAGING / code / value
    path = path.resolve()
    path.relative_to(STAGING / code)
    raw = path.read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    url = '/images/questions/batch3/' + digest + path.suffix.lower()
    target = ROOT / 'public' / url[1:]
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(path, target)
    ASSETS[path.relative_to(ROOT).as_posix()] = {'url': url, 'sha256': digest}
    return url


def records(code):
    result = []
    for path in sorted((STAGING / code).glob('*.json')):
        if not re.match(r'202[456](?:-|\.)', path.name):
            continue
        data = read(path)
        qs = data.get('questions', []) if isinstance(data, dict) else data
        for question in qs:
            result.append((question, data.get('year', int(path.name[:4])) if isinstance(data, dict) else int(path.name[:4])))
    return result


def project(code, q, year):
    if q.get('scoring') == 'all-correct' or isinstance(q.get('scoring'), dict) and q['scoring'].get('kind') == 'all-correct':
        EXCLUDED.append({'exam': code, 'id': q['id'], 'reason': '�����S�������B�ʏ퉉�K�E�P�ꎈ�̓_���珜�O�B'})
        return None
    session = q.get('session', q.get('track', 'gakka'))
    # Preserve track-specific papers and category-local numbering in distinct sessions.
    if code == 'benrishi':
        session = {'�����E���p�V��': 'patent', '�ӏ�': 'design', '���W': 'trademark', '���': 'treaty', '���쌠�@�E�s�������h�~�@': 'copyright'}[q['category']]
    if code == 'dokugeki-chiba':
        session = 'dokugeki-' + q['track']
    category_names = {'hoki': '���s�Ɩ@��', 'yakkan': '���s�Ɩ�', 'jitsumu': '�������s����'} if code == 'chiiki-ryoko' else {}
    category = category_names.get(q.get('category', session), q.get('category', session))
    number = q.get('qNumber', q.get('number', q.get('officialQuestionNumber')))
    images = q.get('sourceImages', q.get('sourcePageImages', [q['sourceImage']] if q.get('sourceImage') else q.get('imageUrls', [])))
    answer_images = q.get('answerImageUrls', [])
    question = q.get('question', q.get('text', ''))
    choices = q.get('choices', {})
    explanations = q.get('choiceExplanations', {})
    if code == 'sokuryoshi':
        documents = {d['id']: d for d in read(STAGING / code / 'source-manifest.json')['documents']}
        def pages(refs):
            return [next(p['asset'] for p in documents[r['documentId']]['pages'] if p['page'] == r['page']) for r in refs]
        images = pages(q['originalQuestion']['sourcePages']) + pages(q.get('answerSheetPages', []))
        answer_images = pages(q['originalAnswer']['sourcePages']) if q['session'] == 'pm' else []
        question = q['originalQuestion'].get('selector', q['officialQuestionLabel']) + '\n�����̖{���E�I�����E�}�\�͎��̌��{�摜�Ŋm�F���Ă��������B'
        choices = {KEYS[i]: f'���{�̑I����{c["officialNumber"]}' for i, c in enumerate(q.get('choices', []))}
        explanations = {KEYS[i]: c['explanation'] for i, c in enumerate(q.get('choices', []))}
    elif isinstance(choices, list):
        choices = {KEYS[i]: c.get('text', '') if isinstance(c, dict) else c for i, c in enumerate(choices)}
    elif choices and '1' in choices:
        choices = {KEYS[int(k)-1]: v for k, v in choices.items()}
    if isinstance(explanations, list):
        explanations = {KEYS[i]: c.get('explanation', c.get('text', '')) if isinstance(c, dict) else c for i, c in enumerate(explanations)}
    elif explanations and '1' in explanations:
        explanations = {KEYS[int(k)-1]: v for k, v in explanations.items()}
    answer = q.get('answer')
    if answer is None:
        numbers = q.get('acceptedAnswerNumbers') or [q.get('correctChoice', q.get('officialAnswerNumber'))]
        answer = [KEYS[int(n)-1] for n in numbers if n is not None and str(n).isdigit()]
        if len(answer) == 1:
            answer = answer[0]
    context = '\n\n'.join(str(q[k]) for k in ['sharedContext', 'sharedPrompt', 'choiceHeader', 'postOptionContent'] if q.get(k))
    if context and not question.startswith(context):
        question = context + '\n\n' + question
    result = {
        'id': q['id'], 'exam': code, 'year': year, 'season': q.get('season', 'annual'), 'session': session,
        'qNumber': number, 'type': q.get('type', 'multiple-choice'), 'category': category,
        'topicTags': [category_names.get(tag, tag) for tag in q.get('topicTags', [category])], 'difficulty': q.get('difficulty', 3),
        'question': question, 'answer': answer, 'explanation': q.get('explanation', ''),
        'sourcePdfUrl': q.get('sourcePdfUrl', q.get('sourcePdfUrls', [''])[0]),
        'sourceAnswerUrl': q.get('sourceAnswerUrl'), 'sourceAttribution': q.get('sourceAttribution', q.get('attribution')),
        'license': 'INT7-owner-decision', 'publicAllowed': True, 'needsReview': False,
        'lastUpdated': q.get('lastUpdated', '2026-11-05'), 'hasImage': bool(images or q.get('choiceImageUrls')),
    }
    for field in ['fiscalYear', 'examDate', 'officialAnswerNumber', 'officialQuestionLabel', 'requiredSelections', 'lawReferenceDate', 'originalContent', 'questionNotice', 'sourceRubies', 'choiceFactTruth', 'acceptedAnswerCombinations', 'modelAnswer', 'scoringCriteria', 'explanationSections', 'officialReferenceUrls', 'isCalculation', 'sourcePresentation', 'sourceExamYear', 'sourceExamSession', 'publicationVersion']:
        if q.get(field) is not None:
            result[field] = q[field]
    if choices:
        result['choices'] = choices
        result['choiceExplanations'] = explanations
        result['explanationCoverage'] = 'full'
    if images:
        result['imageUrls'] = [asset('kenchikushi2' if code == 'mokuzo-kenchikushi' else code, v) for v in images]
        result['imageAltTexts'] = q.get('imageAltTexts') or [f'{year}�N {q.get("officialQuestionLabel", number)} �����E�}�\�i{i+1}/{len(images)}�j' for i in range(len(images))]
    if q.get('choiceImageUrls'):
        result['choiceImageUrls'] = {k: asset('kenchikushi2' if code == 'mokuzo-kenchikushi' else code, v) for k, v in q['choiceImageUrls'].items()}
    if answer_images:
        result['answerImageUrls'] = [asset(code, v) for v in answer_images]
        result['answerImageAltTexts'] = [f'{year}�N �ߌ� No.{number} �����𓚗�i{i+1}�j' for i in range(len(answer_images))]
    if result['type'] == 'descriptive':
        result['answer'] = ''
        result.pop('choices', None)
        result.pop('choiceExplanations', None)
        result['modelAnswer'] = '\n\n'.join(s['label'] + '\n' + s['text'] for s in q.get('explanationSections', []))
        result['explanation'] = result['modelAnswer']
        result['answer'] = result['modelAnswer']
        result['scoringCriteria'] = '�����𓚗�ƓƎ������p���Ď��Ȋm�F���܂��B�L�q�E��}�͎����̓_���܂���B�K�{No.1�ƑI��No.2?5����2�肪���ۂ̉𓚑Ώۂł��B'
    references = list(q.get('officialReferenceUrls', [])) + list(q.get('explanationSourceUrls', []))
    references += [r['url'] for r in q.get('explanationReferences', []) if isinstance(r, dict) and r.get('url')]
    if references:
        result['officialReferenceUrls'] = list(dict.fromkeys(references))
    if q.get('sourceIssue'):
        result['questionNotice'] = q['sourceIssue'].removesuffix('���J�O�ɗv�m�F�B').strip()
    assert result['question'] and result['explanation'], (code, q['id'])
    return result


def main():
    OUTPUT.mkdir(parents=True, exist_ok=True)
    REPORT.mkdir(parents=True, exist_ok=True)
    corpora = {}
    for code in ['benrishi', 'sokuryoshi', 'dokugeki-chiba', 'jokaso-setsubishi', 'chiiki-ryoko', 'junkango-kansai', 'kukaku-seiri', 'dojo-osen']:
        corpora[code] = [r for q, year in records(code) if (r := project(code, q, year))]
    for path in sorted((STAGING / 'kenchikushi2').glob('*.ts')):
        if not re.match(r'(?:mokuzo-)?202[56]-', path.name):
            continue
        text = path.read_text(encoding='utf-8-sig')
        data = json.loads(text[text.index('= [')+2:text.rindex(']')+1])
        for q in data:
            r = project(q['exam'], q, q['year'])
            corpora.setdefault(q['exam'], []).append(r)
    expected = {'benrishi': 120, 'sokuryoshi': 66, 'dokugeki-chiba': 480, 'jokaso-setsubishi': 100, 'chiiki-ryoko': 118, 'junkango-kansai': 299, 'kukaku-seiri': 40, 'dojo-osen': 159, 'kenchikushi2': 200, 'mokuzo-kenchikushi': 200}
    for code, questions in corpora.items():
        assert len(questions) == expected[code], (code, len(questions))
        assert len({q['id'] for q in questions}) == len(questions)
        (OUTPUT / (code + '.json')).write_text(json.dumps(questions, ensure_ascii=False, indent=2)+'\n', encoding='utf-8')
    receipt = {'authorization': 'INT7 owner instruction to publish the named qualifications; no assertion of copyright-holder permission or human specialist review.', 'counts': {k: len(v) for k,v in corpora.items()}, 'excluded': EXCLUDED, 'assets': ASSETS}
    (REPORT / 'projection-receipt.json').write_text(json.dumps(receipt, ensure_ascii=False, indent=2)+'\n', encoding='utf-8')
    print(json.dumps({'counts': receipt['counts'], 'excluded': len(EXCLUDED), 'assets': len(ASSETS)}, ensure_ascii=False))


if __name__ == '__main__':
    main()
