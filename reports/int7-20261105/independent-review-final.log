+  if (q.exam === "kisho" && q.year === 2026) return q.season === "second" ? "第65回（2026年1月25日）" : "第66回（2026年8月23日）";
+  if (q.exam === "riku-tech1" && q.season === "july") return `${q.year}年7月試験`;
+  if (q.exam === "shika-ishi" && q.season === "annual" && (q.year === 2025 || q.year === 2026)) {
