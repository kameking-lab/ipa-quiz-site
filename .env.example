# Database
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# AI Providers
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Sentry — クライアント側(ブラウザ)に公開されるDSN
NEXT_PUBLIC_SENTRY_DSN=
# Sentry — サーバー/Edge側のDSN（クライアントと同値でよい）
SENTRY_DSN=
# Sentry Auth Token: sentry.io → Settings → Auth Tokens で発行
SENTRY_AUTH_TOKEN=
# Sentry Organization slug: sentry.io のURL中の org名
SENTRY_ORG=
# Sentry Project slug: sentry.io のプロジェクト名
SENTRY_PROJECT=
# 環境識別子: production / preview / development（省略時は VERCEL_ENV を使用）
SENTRY_ENVIRONMENT=
# クライアント側の環境識別子（省略時は VERCEL_ENV を使用）
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Affiliate
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=

# Admin Auth
ADMIN_BASIC_USER=
ADMIN_BASIC_PASS=

# Upstash KV — IP rate limiting & API usage dashboard (/admin/api-usage)
# Create a KV database at console.upstash.com, then copy the REST credentials.
# When unset, IP rate limiting is disabled (in-memory limits still apply).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cron
SLACK_WEBHOOK_URL=

# Cloudflare Turnstile (spam protection for /api/feedback)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SEO Verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# /stats Dashboard — Google Search Console (OAuth 2.0 refresh token)
# Requires GCP OAuth Client (Web app type) + owner's refresh token via consent flow.
GSC_SITE_URL=
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=

# /stats Dashboard — PostHog server-side (HogQL via Personal API Key)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com

# /admin/launch-monitoring — Vercel Web Analytics (optional)
# Vercel → Settings → Tokens で Personal Access Token を発行。
# VERCEL_PROJECT_ID は Vercel が自動注入するため手動設定不要。
# VERCEL_TEAM_ID はチームプランの場合のみ必要。
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
