# Upstash KV — IP rate limiting & API usage dashboard (/admin/api-usage)
# Create a KV database at console.upstash.com, then copy the REST credentials.
# When unset, IP rate limiting is disabled (in-memory limits still apply).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cron
SLACK_WEBHOOK_URL=

# SEO Verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# /stats Dashboard — Google Search Console (OAuth 2.0 refresh token)
# Requires GCP OAuth Client (Web app type) + owner's refresh token via consent flow.
GSC_SITE_URL=
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=

# /stats Dashboard — PostHog server-side (HogQL via Personal API Key)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com
