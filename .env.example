# =============================================================================
# IPA Quiz — 環境変数テンプレート
# =============================================================================
# このファイルをコピーして `.env.local` を作成してください。
#   cp .env.example .env.local
# `.env.local` は .gitignore 済み。シークレットを直接書いて構いません。
# 値の変更ルールは CLAUDE.md「10. 承認必須事項」を参照。
# =============================================================================

# -----------------------------------------------------------------------------
# サイト URL（OGP / sitemap / canonical / Stripe redirect で参照）
# 本番では Vercel の環境変数で設定。ローカルは未設定で OK。
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://ipa-quiz-site.vercel.app

# -----------------------------------------------------------------------------
# LLM プロバイダ（AI コパイロット）
# - 未設定 / キー無しの場合は lib/ai/providers/mock.ts に自動フォールバック
# - LLM_PROVIDER は "gemini" 固定（Claude/OpenAI はスタブのみ・利用不可）
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_FREE=gemini-2.5-flash-lite
GEMINI_MODEL_PREMIUM=gemini-2.5-flash

# -----------------------------------------------------------------------------
# レート制限（β 期間中の値・本番リリース時に再調整）
# -----------------------------------------------------------------------------
BETA_DAILY_LIMIT=50
BETA_MINUTE_LIMIT=15

# -----------------------------------------------------------------------------
# データベース（Prisma + Supabase / Neon 等）
# 未設定でも localStorage モードで動作する。設定すると履歴同期・課金が有効化。
# -----------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
# NextAuth（Google / GitHub / Email マジックリンク）
# AUTH_SECRET は `openssl rand -base64 32` で生成
# -----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=
AUTH_TRUST_HOST=true

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email マジックリンク（nodemailer SMTP URL: smtp://user:pass@host:port）
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM=

# -----------------------------------------------------------------------------
# Stripe（プレミアム月額 300 円）
# 未設定でも /pricing は閲覧可能（チェックアウトのみ無効化）
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM_MONTHLY=

# -----------------------------------------------------------------------------
# 管理画面 Basic 認証（/admin/stats/* に適用）
# 未設定の場合は 503 を返して保護される（middleware.ts 参照）
# -----------------------------------------------------------------------------
ADMIN_BASIC_USER=
ADMIN_BASIC_PASS=

# -----------------------------------------------------------------------------
# アフィリエイト（フェーズ4 で利用予定）
# ANZEN AI と共有 ID。値の変更は CLAUDE.md 承認必須事項。
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AMAZON_TAG=safeaisite22-22
NEXT_PUBLIC_RAKUTEN_ID=5291f19d.a0fc3c16.5291f19e.b91d11f6

# -----------------------------------------------------------------------------
# 監視・分析（任意・未設定でも動作）
# - Vercel Analytics は @vercel/analytics で自動送信、追加設定不要
# - 以下は将来導入予定の枠（実装時に有効化）
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Slack 通知（運用アラート / 課金イベント通知用・任意）
# -----------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=
# SLACK_ALERT_CHANNEL=#ipa-quiz-alerts

# -----------------------------------------------------------------------------
# 雑多
# -----------------------------------------------------------------------------
# email-list API のファイル保存先（既定: ./.data）
# EMAIL_LIST_DIR=
