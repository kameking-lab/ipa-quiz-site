# ─── ipa-quiz-site 環境変数テンプレート ───────────────────────────────────────
# このファイルをコピーして .env.local を作成してください。
# 本番(Vercel)は Project → Settings → Environment Variables に設定。
#
# 必須(★) / 推奨(◎) / 任意(○)

# ─── Site ──────────────────────────────────────────────────────────────────
# ★ Canonical URL。production では https://ipa-quiz-site.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Database (Neon Postgres) ─────────────────────────────────────────────
# ★ NextAuth, Stripe Subscription, StudyRecord 等で使用
# 開発時は無設定でも動作（localStorage 履歴のみ）
DATABASE_URL=""

# ─── NextAuth.js v5 ───────────────────────────────────────────────────────
# ★ JWT 署名鍵。`openssl rand -base64 32` で生成
AUTH_SECRET=""

# ◎ Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ◎ GitHub OAuth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ◎ Email Magic Link (Nodemailer / Resend SMTP 経由)
# AUTH_EMAIL_SERVER 形式: smtp://user:pass@host:port
AUTH_EMAIL_SERVER=""
AUTH_EMAIL_FROM="noreply@ipa-quiz.example"

# ─── LLM (Google Gemini) ──────────────────────────────────────────────────
# ◎ 未設定時は mock provider に自動 fallback
GEMINI_API_KEY=""
# ○ プラン別モデル上書き（未設定なら lib/ai/providers/gemini.ts 既定値）
GEMINI_MODEL_FREE="gemini-2.5-flash-lite"
GEMINI_MODEL_PREMIUM="gemini-2.5-flash"
# ○ プロバイダ強制（"gemini" | "claude" | "openai" | "mock"）
LLM_PROVIDER=""

# ─── Stripe ───────────────────────────────────────────────────────────────
# ◎ Premium 課金開始時に必須。テスト中は test key
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ★ Stripe Dashboard で作成した price.id
STRIPE_PRICE_ID_PREMIUM=""
STRIPE_PRICE_ID_TEAM=""

# ─── Resend (お問い合わせ・Magic Link) ────────────────────────────────────
RESEND_API_KEY=""
# ○ 法人問い合わせ転送先（未設定なら 503）
ENTERPRISE_CONTACT_TO=""
ENTERPRISE_CONTACT_FROM=""

# ─── レート制限 (任意・既定値推奨) ────────────────────────────────────────
# ○ 既定 50 / 日。CLAUDE.md 承認必須事項
BETA_DAILY_LIMIT="50"
# ○ 既定 10 / 分（Premium ソフト上限）
BETA_MINUTE_LIMIT="10"

# ─── 管理画面 (/admin) Basic Auth ────────────────────────────────────────
ADMIN_BASIC_USER=""
ADMIN_BASIC_PASS=""

# ─── 監視・ログ ───────────────────────────────────────────────────────────
# ○ Sentry DSN。未設定なら console.error のみ
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# ─── ローカル運用 ─────────────────────────────────────────────────────────
# ○ メールリスト一時保存先（lib/email-list/store.ts）
EMAIL_LIST_DIR="./.data/email-list"
