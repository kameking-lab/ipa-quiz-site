# ===========================================================================
# IPA Quiz — Environment Variables Example
# ===========================================================================
# Copy to `.env.local` for local development. All variables are optional;
# the app falls back to safe defaults / mock providers when keys are missing.
# Production values are configured in Vercel project env vars per environment.
# ---------------------------------------------------------------------------

# ------------------------- Site -------------------------
NEXT_PUBLIC_SITE_URL=                 # 本番 URL (例: https://ipa-quiz-site.vercel.app)。未設定時は VERCEL_URL を自動使用

# ------------------------- LLM (Gemini) -------------------------
LLM_PROVIDER=gemini                   # 現状 gemini のみサポート (claude/openai はスタブ)
GEMINI_API_KEY=                       # 空の場合は lib/ai/providers/mock.ts にフォールバック
GEMINI_MODEL_FREE=gemini-2.5-flash-lite
GEMINI_MODEL_PREMIUM=gemini-2.5-flash

# ------------------------- レート制限 -------------------------
FREE_DAILY_LIMIT=30                   # 無料ユーザー 1日の AI コパイロット回数 (CLAUDE.md 承認必須)
PREMIUM_MINUTE_LIMIT=10               # プレミアム 1分のソフトリミット
BETA_DAILY_LIMIT=50                   # β期間中の追加緩和枠
BETA_MINUTE_LIMIT=15

# ------------------------- 認証 (NextAuth.js v5) -------------------------
AUTH_SECRET=                          # 必須 (本番)。openssl rand -base64 32 で生成
AUTH_URL=                             # 本番のみ必須 (例: https://ipa-quiz-site.vercel.app)
AUTH_TRUST_HOST=true                  # Vercel デプロイ時は true

# Google OAuth (任意)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (任意)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email Magic Link (任意, Nodemailer SMTP)
AUTH_EMAIL_SERVER=                    # 例: smtp://apikey:<sendgrid_api_key>@smtp.sendgrid.net:587
AUTH_EMAIL_FROM=                      # 例: noreply@ipa-quiz.app

# ------------------------- データベース -------------------------
DATABASE_URL=                         # Postgres URL (Vercel Postgres / Supabase 等)。未設定時はゲストモードで動作

# ------------------------- Stripe (課金) -------------------------
STRIPE_SECRET_KEY=                    # sk_test_... / sk_live_...
STRIPE_WEBHOOK_SECRET=                # whsec_... (Webhook 署名検証)
STRIPE_PRICE_ID_PREMIUM=              # 月額プレミアム Price ID (price_...)
STRIPE_PRICE_ID_TEAM=                 # 月額チーム Price ID (price_...)

# ------------------------- 管理者画面 (Basic 認証) -------------------------
ADMIN_BASIC_USER=                     # /admin/stats/* のアクセス制御
ADMIN_BASIC_PASS=                     # 強力なパスフレーズ推奨

# ------------------------- メール購読リスト -------------------------
EMAIL_LIST_DIR=                       # 既定: <repo>/.data。Vercel ではエフェメラル

# ------------------------- 計測・監視 (Phase4 以降に実装予定) -------------------------
# 以下は未実装。env.example に枠だけ確保しておき、導入時に同名キーで参照する。

# PostHog (プロダクト解析、A/B テスト)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (エラー監視)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Slack 通知 (運用アラート / お問合せ転送)
SLACK_WEBHOOK_URL=

# ------------------------- アフィリエイト -------------------------
NEXT_PUBLIC_AMAZON_TAG=safeaisite22-22
NEXT_PUBLIC_RAKUTEN_ID=5291f19d.a0fc3c16.5291f19e.b91d11f6
