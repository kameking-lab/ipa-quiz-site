# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw IPA PDFs (fetched by scripts/fetch-ipa-pdfs.ts, not committed)
/data/raw_pdfs/

# parse script output logs
/logs/*.json
# bot tracking files (exception to the above)
!/logs/auto-improve-history.json
# regenerate-explanations backup copies of data files
/logs/backup_*.ts
/logs/sc-choice-explanations-2024-2025/

# email-list API file-based store (app/api/email-list)
/.data/

# local editor
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.vercel

# Playwright
/test-results
/playwright-report
/playwright/.cache
.cache/fp2-official/
scripts/__pycache__/

# locally downloaded official PDFs and Python bytecode
/.cache/
/tmp/lq1b-*
**/__pycache__/
*.pyc
# LQ3B local PDF rendering/OCR cache and verbose execution logs.
# Reviewed manuscripts, source PDFs, sorted OCR evidence and final receipts are tracked.
/reports/LQ3B-20261104/rendered/
/reports/LQ3B-20261104/*-ocr.txt
/reports/LQ3B-20261104/sanitary-2025-page1.png
/reports/LQ3B-20261104/*.log
/reports/LQ3C-20261104/local/
/reports/LQ3C-20261104/*-execution.log

# LQ7 local PDF comparison and CLI review intermediates
/tmp/shuwa/

# build-time artifacts (pnpm copilot:index:write; regenerated by pnpm build)
/generated/
