# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw IPA PDFs (fetched by scripts/fetch-ipa-pdfs.ts, not committed)
/data/raw_pdfs/

# parse script output logs
/logs/*.json
# bot tracking files (exception to the above)
!/logs/auto-improve-history.json
# regenerate-explanations backup copies of data files
/logs/backup_*.ts

# email-list API file-based store (app/api/email-list)
/.data/

# local editor
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.vercel

# Playwright
/test-results
/playwright-report
/playwright/.cache
